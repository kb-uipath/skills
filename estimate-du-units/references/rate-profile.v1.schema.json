{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uipath:codex-skill:estimate-du-units:rate-profile:v1",
  "title": "Estimate DU Units Rate Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "rates"
  ],
  "properties": {
    "schema_version": {
      "const": "estimate-du-units.rate-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "unit",
          "rate",
          "source_url",
          "accessed_on",
          "effective_on",
          "max_age_days"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "ai_unit",
              "platform_unit"
            ]
          },
          "rate": {
            "$ref": "#/$defs/nonnegativeDecimal"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "effective_on": {
            "type": "string",
            "format": "date"
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "nonnegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  }
}
