{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uipath:codex-skill:estimate-du-units:input:v1",
  "title": "Estimate DU Units Structured Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estimate_id",
    "as_of",
    "applicability",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "estimate-du-units.input.v1"
    },
    "estimate_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "documents"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "annual_transactions",
                "pages_per_transaction"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "annual_transactions": {
                  "$ref": "#/$defs/nonnegativeDecimal"
                },
                "pages_per_transaction": {
                  "$ref": "#/$defs/nonnegativeDecimal"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonnegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  }
}
