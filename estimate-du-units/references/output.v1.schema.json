{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uipath:codex-skill:estimate-du-units:output:v1",
  "title": "Estimate DU Units Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estimate_id",
    "input_mode",
    "as_of",
    "applicability",
    "calculation_applied",
    "rate_context",
    "scenarios",
    "warnings",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "estimate-du-units.output.v1"
    },
    "estimate_id": {
      "type": "string",
      "minLength": 1
    },
    "input_mode": {
      "enum": [
        "structured",
        "legacy_case"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "calculation_applied": {
      "type": "boolean"
    },
    "rate_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile_id",
        "stale_override_used",
        "components",
        "totals_per_page"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rate_profile",
            "explicit_cli"
          ]
        },
        "profile_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stale_override_used": {
          "type": "boolean"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "unit",
              "rate",
              "source_url",
              "accessed_on",
              "effective_on",
              "max_age_days",
              "age_days",
              "is_stale"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "$ref": "#/$defs/unit"
              },
              "rate": {
                "$ref": "#/$defs/nonnegativeDecimal"
              },
              "source_url": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessed_on": {
                "type": "string",
                "format": "date"
              },
              "effective_on": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_age_days": {
                "type": "integer",
                "minimum": 0
              },
              "age_days": {
                "type": "integer",
                "minimum": 0
              },
              "is_stale": {
                "type": "boolean"
              }
            }
          }
        },
        "totals_per_page": {
          "$ref": "#/$defs/rateTotals"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "documents",
          "totals"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "annual_transactions",
                "pages_per_transaction",
                "annual_pages",
                "units"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "annual_transactions": {
                  "$ref": "#/$defs/nonnegativeDecimal"
                },
                "pages_per_transaction": {
                  "$ref": "#/$defs/nonnegativeDecimal"
                },
                "annual_pages": {
                  "$ref": "#/$defs/nonnegativeDecimal"
                },
                "units": {
                  "$ref": "#/$defs/unitResults"
                }
              }
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "annual_pages",
              "units"
            ],
            "properties": {
              "annual_pages": {
                "$ref": "#/$defs/nonnegativeDecimal"
              },
              "units": {
                "$ref": "#/$defs/unitResults"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "unit": {
      "enum": [
        "ai_unit",
        "platform_unit"
      ]
    },
    "nonnegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "roundedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "unitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "rounded"
      ],
      "properties": {
        "exact": {
          "$ref": "#/$defs/nonnegativeDecimal"
        },
        "rounded": {
          "$ref": "#/$defs/roundedDecimal"
        }
      }
    },
    "unitResults": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ai_unit": {
          "$ref": "#/$defs/unitResult"
        },
        "platform_unit": {
          "$ref": "#/$defs/unitResult"
        }
      }
    },
    "rateTotals": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ai_unit": {
          "$ref": "#/$defs/nonnegativeDecimal"
        },
        "platform_unit": {
          "$ref": "#/$defs/nonnegativeDecimal"
        }
      }
    }
  }
}
