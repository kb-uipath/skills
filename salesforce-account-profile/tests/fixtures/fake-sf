#!/usr/bin/env node
import { readFileSync } from "node:fs";

const args = process.argv.slice(2);
const command = `${args[0] ?? ""} ${args[1] ?? ""}`;
const flag = (name) => args[args.indexOf(name) + 1];
const alias = flag("--target-org");

const IDs = {
  account1: "001000000000001AAA",
  account2: "001000000000002AAA",
  account3: "001000000000003AAA",
  account4: "001000000000004AAA",
  account5: "001000000000005AAA",
  opportunity1: "006000000000001AAA",
  opportunity2: "006000000000002AAA",
  user1: "005000000000001AAA",
  user2: "005000000000002AAA",
  line1: "00k000000000001AAA",
  line2: "00k000000000002AAA",
};

const customAccountFields = [
  "Ultimate_Parent_name__c", "Classification__c", "Region__c", "Geo__c",
  "Contract_End_Date__c", "Support_Type__c",
  "Support_Status__c", "CSM__c", "Support_Technical_Advisor__c", "PreSales__c",
];
const descriptions = {
  Account: ["Id", "Name", "ParentId", "OwnerId", ...(alias === "synthetic-missing" ? [] : customAccountFields)],
  Opportunity: ["Id", "Name", "AccountId", "OwnerId", "StageName", "Amount", "CloseDate", "IsClosed", "IsWon", "CurrencyIsoCode", "HasOpportunityLineItem", "Type", "Deal_Type__c", "Contract_Start_Date__c", "Contract_End_Date__c", "Renewal_Status__c"],
  OpportunityLineItem: ["Id", "OpportunityId", "Quantity", "UnitPrice", "TotalPrice", "CurrencyIsoCode", "PricebookEntryId", "ServiceDate"],
  PricebookEntry: ["Id", "Product2Id"],
  Product2: ["Id", "Name"],
  User: ["Id", "Name", "Title", "ManagerId"],
};

const nameForAlias = alias === "synthetic-adversarial"
  ? "O'Brien `$(touch CODE_EXECUTION_SENTINEL)`\u202e\u001b[31m"
  : "Example Holdings";
const accounts = [
  {
    Id: IDs.account1, Name: nameForAlias, ParentId: null, OwnerId: IDs.user1,
    Ultimate_Parent_name__c: "Example Family", Classification__c: "Synthetic",
    Region__c: null, Geo__c: null, Contract_End_Date__c: null,
    Support_Type__c: null, Support_Status__c: null, CSM__c: null,
    Support_Technical_Advisor__c: null, PreSales__c: null,
  },
  {
    Id: IDs.account2, Name: "Example Division", ParentId: IDs.account1, OwnerId: IDs.user2,
    Ultimate_Parent_name__c: "Example Family", Classification__c: "Synthetic",
    Region__c: null, Geo__c: null, Contract_End_Date__c: null,
    Support_Type__c: null, Support_Status__c: null, CSM__c: null,
    Support_Technical_Advisor__c: null, PreSales__c: null,
  },
];
const ambiguousAccounts = [
  {
    Id: IDs.account1, Name: "Repeated Name", ParentId: null, OwnerId: IDs.user1,
    Ultimate_Parent_name__c: null, Classification__c: null, Region__c: null,
    Geo__c: null, Contract_End_Date__c: null, Support_Type__c: null,
    Support_Status__c: null, CSM__c: null,
    Support_Technical_Advisor__c: null, PreSales__c: null,
  },
  {
    Id: IDs.account3, Name: "Repeated Name", ParentId: null, OwnerId: IDs.user1,
    Ultimate_Parent_name__c: null, Classification__c: null, Region__c: null,
    Geo__c: null, Contract_End_Date__c: null, Support_Type__c: null,
    Support_Status__c: null, CSM__c: null,
    Support_Technical_Advisor__c: null, PreSales__c: null,
  },
];
const opportunities = [
  {
    Id: IDs.opportunity1, Name: "Open Synthetic Deal", AccountId: IDs.account1,
    OwnerId: IDs.user1, StageName: "Discovery", Amount: 100, CloseDate: "2030-01-01",
    IsClosed: false, IsWon: false, CurrencyIsoCode: "USD", HasOpportunityLineItem: true,
  },
  {
    Id: IDs.opportunity2, Name: "Closed Synthetic Deal", AccountId: IDs.account2,
    OwnerId: IDs.user2, StageName: "Closed Won", Amount: 200, CloseDate: "2029-01-01",
    IsClosed: true, IsWon: true, CurrencyIsoCode: "EUR", HasOpportunityLineItem: true,
  },
];
const lineItems = [
  {
    Id: IDs.line1, OpportunityId: IDs.opportunity1, Quantity: 2, UnitPrice: 50,
    TotalPrice: 100, CurrencyIsoCode: "USD", PricebookEntryId: "01u000000000001AAA",
    PricebookEntry: { Product2Id: "01t000000000001AAA", Product2: { Name: "Synthetic Product A" } },
  },
  {
    Id: IDs.line2, OpportunityId: IDs.opportunity2, Quantity: 4, UnitPrice: 50,
    TotalPrice: 200, CurrencyIsoCode: "EUR", PricebookEntryId: "01u000000000002AAA",
    PricebookEntry: { Product2Id: "01t000000000002AAA", Product2: { Name: "Synthetic Product B" } },
  },
];
const users = [
  { Id: IDs.user1, Name: "Synthetic Owner", Title: "Account Executive", ManagerId: IDs.user2 },
  { Id: IDs.user2, Name: "Synthetic Manager", Title: "Manager", ManagerId: null },
];
const certificationMarker = "SAPCERT001";
const certificationAccounts = [
  {
    ...accounts[0],
    Name: `${certificationMarker} Unique Holdings`,
  },
  {
    ...accounts[1],
    Name: `${certificationMarker} Family Division`,
  },
];
const certificationAmbiguousAccounts = [
  {
    ...ambiguousAccounts[0],
    Id: IDs.account3,
    Name: `${certificationMarker} Repeated Name`,
  },
  {
    ...ambiguousAccounts[1],
    Id: IDs.account4,
    Name: `${certificationMarker} Repeated Name`,
  },
];
const certificationPrefixAccounts = [{
  ...ambiguousAccounts[0],
  Id: IDs.account5,
  Name: `${certificationMarker} Prefix Candidate`,
}];
const certificationUsers = users.map((user) => ({
  ...user,
  Name: `${certificationMarker} ${user.Name}`,
}));
const certificationOpportunities = opportunities.map((opportunity) => ({
  ...opportunity,
  Name: `${certificationMarker} ${opportunity.Name}`,
}));
const certificationLineItems = lineItems.map((lineItem) => ({
  ...lineItem,
  PricebookEntry: {
    ...lineItem.PricebookEntry,
    Product2: {
      ...lineItem.PricebookEntry.Product2,
      Name: `${certificationMarker} ${lineItem.PricebookEntry.Product2.Name}`,
    },
  },
}));

function emit(result) {
  process.stdout.write(JSON.stringify({ status: 0, result }));
}

function fieldMetadata(name) {
  const references = {
    ParentId: ["Account"], OwnerId: ["User"], AccountId: ["Account"],
    OpportunityId: ["Opportunity"], PricebookEntryId: ["PricebookEntry"],
    Product2Id: ["Product2"], ManagerId: ["User"], CSM__c: ["User"],
    Support_Technical_Advisor__c: ["User"], PreSales__c: ["User"],
  };
  const relationships = { PricebookEntryId: "PricebookEntry", Product2Id: "Product2" };
  const booleans = new Set(["IsClosed", "IsWon", "HasOpportunityLineItem"]);
  const currencies = new Set(["Amount", "UnitPrice", "TotalPrice"]);
  return {
    name,
    type: name === "Id" ? "id"
      : references[name] ? "reference"
        : booleans.has(name) ? "boolean"
          : currencies.has(name) ? "currency"
            : name === "Quantity" ? "double"
              : name.includes("Date") || name === "ServiceDate" ? "date"
                : name === "CurrencyIsoCode" || name === "StageName" ? "picklist"
                  : "string",
    filterable: true,
    referenceTo: references[name] ?? [],
    relationshipName: relationships[name] ?? null,
    picklistValues: name === "StageName"
      ? [
        { active: true, label: "Closed Won", value: "Closed Won" },
        { active: true, label: "Discovery", value: "Discovery" },
        { active: true, label: "Qualification", value: "Qualification" },
      ]
      : [],
  };
}

if (command === "org list") {
  emit({
    sandboxes: [
      "synthetic-adversarial",
      "synthetic-ambiguous",
      "synthetic-complete",
      "synthetic-certification",
      "synthetic-missing",
      "synthetic-no-match",
    ].map((orgAlias) => ({
      alias: orgAlias,
      username: `${orgAlias}@example.invalid`,
      orgId: "00D000000000001AAA",
      instanceUrl: "https://synthetic.example.invalid",
      connectedStatus: "not_checked",
      accessToken: "00D000000000001!SECRET_SHOULD_NOT_ESCAPE",
    })),
    other: [{
      alias: "synthetic-production",
      username: "synthetic-production@example.invalid",
      orgId: "00D000000000002AAA",
      instanceUrl: "https://production.example.invalid",
      connectedStatus: "not_checked",
      accessToken: "00D000000000002!SECRET_SHOULD_NOT_ESCAPE",
    }],
    devHubs: [],
    scratchOrgs: [],
    nonScratchOrgs: [],
  });
} else if (command === "org display") {
  emit({
    id: alias === "synthetic-production"
      ? "00D000000000002AAA"
      : "00D000000000001AAA",
    username: `${alias}@example.invalid`,
    instanceUrl: alias === "synthetic-production"
      ? "https://production.example.invalid"
      : "https://synthetic.example.invalid",
    connectedStatus: "Connected",
    accessToken: "00D000000000001!SECRET_SHOULD_NOT_ESCAPE",
  });
} else if (command === "sobject describe") {
  const objectName = flag("--sobject");
  emit({ fields: (descriptions[objectName] ?? []).map(fieldMetadata) });
} else if (command === "data query") {
  const soql = readFileSync(flag("--file"), "utf8");
  let records = [];
  if (/FROM Account/u.test(soql)) {
    if (alias === "synthetic-certification") {
      const available = [
        ...certificationAccounts,
        ...certificationAmbiguousAccounts,
        ...certificationPrefixAccounts,
      ];
      if (/Ultimate_Parent_name__c =/u.test(soql)) {
        records = certificationAccounts;
      } else if (/WHERE Id (?:=|IN)/u.test(soql)) {
        records = available.filter((account) => soql.includes(account.Id));
      } else if (soql.includes(`${certificationMarker} Unique Holdings`)) {
        records = [certificationAccounts[0]];
      } else if (soql.includes(`${certificationMarker} Repeated Name`)) {
        records = certificationAmbiguousAccounts;
      } else if (soql.includes(`${certificationMarker} No Exact Match`)) {
        records = [];
      } else if (soql.includes(`${certificationMarker} Prefix`)) {
        records = certificationPrefixAccounts;
      }
    } else if (alias === "synthetic-ambiguous" && /Name =/u.test(soql)) {
      records = ambiguousAccounts;
    } else if (alias === "synthetic-no-match" && /Name =/u.test(soql)) {
      records = [];
    } else if (/Ultimate_Parent_name__c =/u.test(soql)) {
      records = accounts;
    } else if (/WHERE Id IN/u.test(soql)) {
      const available = alias === "synthetic-ambiguous"
        ? ambiguousAccounts
        : accounts;
      records = available.filter((account) => soql.includes(account.Id));
    } else if (/WHERE Id =/u.test(soql)) {
      const available = alias === "synthetic-ambiguous"
        ? ambiguousAccounts
        : accounts;
      records = available.filter((account) => soql.includes(account.Id));
    } else if (/Name (?:=|LIKE)/u.test(soql)) {
      records = [accounts[0]];
    }
  } else if (/FROM OpportunityLineItem/u.test(soql)) {
    const available = alias === "synthetic-certification"
      ? certificationLineItems
      : lineItems;
    records = available.filter((item) => soql.includes(item.OpportunityId));
  } else if (/FROM Opportunity/u.test(soql)) {
    const available = alias === "synthetic-certification"
      ? certificationOpportunities
      : opportunities;
    records = available.filter((item) => soql.includes(item.AccountId));
    if (/IsClosed = false/u.test(soql)) records = records.filter((item) => !item.IsClosed);
    if (/IsClosed = true/u.test(soql)) records = records.filter((item) => item.IsClosed);
  } else if (/FROM User/u.test(soql)) {
    const available = alias === "synthetic-certification"
      ? certificationUsers
      : users;
    records = available.filter((user) => soql.includes(user.Id));
  }
  emit({ totalSize: records.length, done: true, records });
} else {
  process.stderr.write("unsupported synthetic command");
  process.exitCode = 1;
}
